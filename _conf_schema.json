{
  "comfyui_base_url": {
    "type": "string",
    "description": "ComfyUI 服务地址",
    "hint": "例如：http://127.0.0.1:8188",
    "default": "http://127.0.0.1:8188"
  },
  "workflows": {
    "type": "template_list",
    "description": "工作流/节点/命令",
    "hint": "把 ComfyUI 导出的 API format JSON 文件放到插件目录或 workflows/ 目录；然后在这里选择文件，并为每个工作流配置节点 ID 与触发命令。新增文件后可重载插件或用 /comfyui refresh 刷新下拉选项。",
    "templates": {
      "workflow": {
        "name": "工作流",
        "items": {
          "id": {
            "type": "string",
            "description": "条目 ID",
            "default": "",
            "invisible": true
          },
          "name": {
            "type": "string",
            "description": "显示名称",
            "default": "主工作流"
          },
          "command": {
            "type": "string",
            "description": "触发命令",
            "hint": "用户使用 /<命令> 来触发。例如：画图、随机图。不要带 /。",
            "default": "画图"
          },
          "aliases": {
            "type": "list",
            "description": "命令别名",
            "hint": "例如：[\"draw\", \"画\"]",
            "default": []
          },
          "workflow_api_file": {
            "type": "string",
            "description": "工作流文件（API JSON）",
            "hint": "下拉列表来自插件目录与 workflows/ 目录中的 .json 文件。",
            "default": "",
            "options": []
          },
          "require_prompt": {
            "type": "bool",
            "description": "是否需要提示词参数",
            "hint": "关闭后允许用户仅输入 /<命令>，使用工作流内默认提示词。",
            "default": true
          },
          "fixed_prompt": {
            "type": "string",
            "description": "固定提示词（可选）",
            "hint": "填写后将忽略用户输入参数，始终使用此提示词。",
            "default": ""
          },
          "prompt_input_node_id": {
            "type": "string",
            "description": "正向提示词输入节点 ID（可选）",
            "hint": "接收画图描述文本的节点 ID（通常是 CLIPTextEncode 正向节点）。留空则不写入提示词。",
            "default": ""
          },
          "prompt_input_field": {
            "type": "string",
            "description": "正向提示词输入字段",
            "hint": "通常填写 text。",
            "default": "text"
          },
          "negative_prompt_input_node_id": {
            "type": "string",
            "description": "负面提示词输入节点 ID（可选）",
            "default": ""
          },
          "negative_prompt_input_field": {
            "type": "string",
            "description": "负面提示词输入字段",
            "default": "text"
          },
          "default_negative_prompt": {
            "type": "string",
            "description": "默认负面提示词（可选）",
            "default": ""
          },
          "seed_randomize": {
            "type": "bool",
            "description": "每次随机种子",
            "hint": "开启后每次触发都会向指定节点写入随机 seed，避免连续两次生成完全相同的图。",
            "default": false
          },
          "seed_input_node_id": {
            "type": "string",
            "description": "Seed 输入节点 ID（可选）",
            "hint": "通常是 KSampler 节点 ID。留空则尝试自动寻找工作流中的 KSampler/含 seed 字段的节点。",
            "default": ""
          },
          "seed_input_field": {
            "type": "string",
            "description": "Seed 字段",
            "hint": "通常填写 seed。",
            "default": "seed"
          },
          "seed_random_min": {
            "type": "int",
            "description": "随机 seed 最小值",
            "default": 0
          },
          "seed_random_max": {
            "type": "int",
            "description": "随机 seed 最大值",
            "default": 4294967295
          },
          "output_node_id": {
            "type": "string",
            "description": "输出图片节点 ID",
            "hint": "最终产出图片的节点 ID（通常是 SaveImage 节点）。",
            "default": ""
          },
          "output_image_index": {
            "type": "int",
            "description": "输出图片序号",
            "hint": "当一个节点输出多张图时，选择第几张（从 0 开始）。",
            "default": 0
          }
        }
      }
    }
  },
  "nlp_target_command": {
    "type": "string",
    "description": "自然语言触发使用的命令",
    "hint": "群聊触发（如：帮我画xxx）时，实际调用哪个 /<命令>。",
    "default": "画图"
  },
  "poll_interval_sec": {
    "type": "float",
    "description": "轮询间隔（秒）",
    "default": 1.0
  },
  "debug_enable": {
    "type": "bool",
    "description": "调试模式",
    "hint": "开启后允许使用 /comfyui debug 输出当前插件配置与解析信息（请勿在公开群聊中开启/使用）。",
    "default": false
  },
  "trigger_require_prefix": {
    "type": "bool",
    "description": "仅斜杠触发",
    "hint": "开启后仅当消息以 / 或 ／ 开头时触发工作流命令。注意：部分前端（如 WebChat）可能会把你输入的 '/随机' 传给插件时变成 '随机'（去掉斜杠），此时需要前端支持保留斜杠，或改用 //随机。",
    "default": false
  },
  "reply_at_sender": {
    "type": "bool",
    "description": "群聊回复 @ 请求人",
    "hint": "开启后在群聊返回图片时会 @ 触发者（仅在平台支持且 sender_id 为数字时生效）。",
    "default": true
  },
  "job_timeout_sec": {
    "type": "int",
    "description": "任务超时（秒）",
    "default": 180
  },
  "save_last_n": {
    "type": "int",
    "description": "保留最近 N 张图片",
    "hint": "更早的图片会自动从 data/plugin_data/... 中删除。",
    "default": 30
  },
  "enable_nlp_draw": {
    "type": "bool",
    "description": "启用自然语言触发（如：帮我画xxx）",
    "default": true
  },
  "nlp_draw_prefixes": {
    "type": "list",
    "description": "自然语言触发前缀",
    "hint": "群消息以这些前缀开头时触发绘图。",
    "default": ["帮我画", "给我画", "帮我生成", "画一张"]
  },
  "llm_prompt_instruction": {
    "type": "text",
    "description": "AI 提示词改写指令",
    "default": "你是 ComfyUI 绘图提示词助手。请把用户需求改写为适合 Stable Diffusion / Flux 的高质量正向提示词，尽量使用英文关键词并保留主体、画风、构图、光影和细节要求。只输出一行提示词，不要解释，不要 Markdown，不要引号。"
  }
}
